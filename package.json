{
  "name": "parlour",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter @parlour/web dev",
    "desktop:dev": "pnpm --filter @parlour/desktop desktop:dev",
    "desktop:build": "pnpm --filter @parlour/desktop desktop:build",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint packages apps --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm -r type-check",
    "sim": "pnpm --filter @parlour/game-blitz sim"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
