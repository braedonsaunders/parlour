{
  "name": "parlour — cozy card games",
  "short_name": "parlour",
  "description": "Pull up a chair for beautifully animated card games with friends or offline against bots.",
  "id": "/",
  "scope": "/",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "landscape",
  "lang": "en-CA",
  "dir": "ltr",
  "background_color": "#152833",
  "theme_color": "#152833",
  "categories": ["games", "entertainment"],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "shortcuts": [
    {
      "name": "Choose a game",
      "short_name": "Games",
      "description": "Browse the parlour game shelf",
      "url": "/games/",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Join a table",
      "short_name": "Join",
      "description": "Enter a friend's room code",
      "url": "/join/",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "prefer_related_applications": false
}
