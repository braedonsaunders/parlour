{
  "name": "@parlour/web",
  "version": "0.3.3",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/generate-pwa.mjs",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "generate:audio": "pnpm run generate:ambience && pnpm run generate:sfx && pnpm run generate:voice && pnpm run generate:music",
    "generate:ambience": "node scripts/generate-ambience.mjs",
    "generate:sfx": "node --env-file=../../.env.local scripts/generate-sfx.mjs",
    "generate:voice": "node --env-file=../../.env.local scripts/generate-voice.mjs",
    "generate:music": "node --env-file=../../.env.local scripts/generate-music.mjs",
    "test:e2e": "playwright test",
    "test:perf": "playwright test --config playwright.perf.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "serve:export": "node scripts/serve-export.mjs out 4321"
  },
  "dependencies": {
    "@parlour/engine": "workspace:*",
    "@parlour/game-blitz": "workspace:*",
    "@parlour/game-cribbage": "workspace:*",
    "@parlour/game-eights": "workspace:*",
    "@parlour/game-euchre": "workspace:*",
    "@parlour/game-freecell": "workspace:*",
    "@parlour/game-gin": "workspace:*",
    "@parlour/game-golf": "workspace:*",
    "@parlour/game-hearts": "workspace:*",
    "@parlour/game-klondike": "workspace:*",
    "@parlour/game-ohhell": "workspace:*",
    "@parlour/game-poker": "workspace:*",
    "@parlour/game-president": "workspace:*",
    "@parlour/game-pyramid": "workspace:*",
    "@parlour/game-ratscrew": "workspace:*",
    "@parlour/game-scopa": "workspace:*",
    "@parlour/game-spades": "workspace:*",
    "@parlour/game-spider": "workspace:*",
    "@parlour/game-spite": "workspace:*",
    "@parlour/game-wildpile": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.13.0",
    "howler": "^2.2.4",
    "motion": "^12.0.0",
    "next": "^16.1.2",
    "nostr-tools": "^2.10.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/howler": "^2.2.12",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.16",
    "jsdom": "^27.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vitest": "^4.0.18"
  }
}
