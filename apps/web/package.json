{
  "name": "@parlour/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "generate:audio": "pnpm run generate:ambience && pnpm run generate:sfx && pnpm run generate:voice",
    "generate:ambience": "node scripts/generate-ambience.mjs",
    "generate:sfx": "node --env-file=../../.env.local scripts/generate-sfx.mjs",
    "generate:voice": "node --env-file=../../.env.local scripts/generate-voice.mjs"
  },
  "dependencies": {
    "@parlour/engine": "workspace:*",
    "@parlour/game-blitz": "workspace:*",
    "@parlour/game-euchre": "workspace:*",
    "@parlour/game-wildpile": "workspace:*",
    "gsap": "^3.13.0",
    "howler": "^2.2.4",
    "motion": "^12.0.0",
    "next": "^16.1.2",
    "nostr-tools": "^2.10.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.16",
    "jsdom": "^27.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vitest": "^4.0.18"
  }
}
